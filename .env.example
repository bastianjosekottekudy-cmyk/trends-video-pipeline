# YouTube Data API upload (youtube.enabled: true in config/pipeline.yaml)
# 1. Place OAuth client JSON at secrets/client_secrets.json
# 2. Run: python -m src.youtube.auth
# 3. Paste the printed refresh token below

# Path to client_secrets.json from Google Cloud Console
YOUTUBE_CLIENT_SECRETS=secrets/client_secrets.json

# Refresh token from: python -m src.youtube.auth
YOUTUBE_REFRESH_TOKEN=

# Set true to force-skip uploads without disabling youtube.enabled
SKIP_YOUTUBE_UPLOAD=false

# Free witty narration via Groq (https://console.groq.com/)
# Leave empty to use template narration fallback
GROQ_API_KEY=

# Optional providers
OPENAI_API_KEY=
NEWSAPI_KEY=

# Database path (default: runs.db in project root)
DB_PATH=runs.db
