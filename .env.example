# Optional — automatic YouTube upload is disabled for now (youtube.enabled: false).
# Keep these for future upload support.

# Path to client_secrets.json from Google Cloud Console
YOUTUBE_CLIENT_SECRETS=secrets/client_secrets.json

# Refresh token from: python -m src.youtube.auth
YOUTUBE_REFRESH_TOKEN=

# Free witty narration via Groq (https://console.groq.com/)
# Leave empty to use template narration fallback
GROQ_API_KEY=

# Optional providers
OPENAI_API_KEY=
NEWSAPI_KEY=

# Database path (default: runs.db in project root)
DB_PATH=runs.db
