# YouTube OAuth — path to client_secrets.json from Google Cloud Console
YOUTUBE_CLIENT_SECRETS=secrets/client_secrets.json

# Refresh token obtained after first OAuth flow (python -m src.youtube.auth)
YOUTUBE_REFRESH_TOKEN=

# Optional: skip YouTube upload during development
SKIP_YOUTUBE_UPLOAD=false

# Optional providers
OPENAI_API_KEY=
NEWSAPI_KEY=

# Database path (default: runs.db in project root)
DB_PATH=runs.db
